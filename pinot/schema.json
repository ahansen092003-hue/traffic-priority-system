{
  "schemaName": "vehicle_positions",
  "dimensionFieldSpecs": [
    {"name": "vehicle_id",   "dataType": "STRING"},
    {"name": "vehicle_type", "dataType": "STRING"},
    {"name": "step",         "dataType": "INT"}
  ],
  "metricFieldSpecs": [
    {"name": "lat",          "dataType": "DOUBLE"},
    {"name": "lon",          "dataType": "DOUBLE"},
    {"name": "speed",        "dataType": "FLOAT"},
    {"name": "time_stopped", "dataType": "FLOAT"}
  ],
  "dateTimeFieldSpecs": [{
    "name":        "ts",
    "dataType":    "LONG",
    "format":      "1:SECONDS:EPOCH",
    "granularity": "1:SECONDS"
  }]
}